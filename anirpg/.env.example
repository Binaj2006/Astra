# ╔══════════════════════════════════════════════════════╗
# ║           AniRPG — Environment Variables             ║
# ║  Copy this to .env and fill in your values           ║
# ║  NEVER commit .env to git! (it's in .gitignore)      ║
# ╚══════════════════════════════════════════════════════╝

# ── Database ──────────────────────────────────────────────
# SECURITY: Required. Bot will refuse to start without it.
# Get from MongoDB Atlas: Connect → Drivers → Connection String
MONGODB_URI=

# ── Owner & Co-owner JIDs ─────────────────────────────────
# Use the full WhatsApp JID format: number@s.whatsapp.net or number@lid
OWNER_JID=221951679328499@lid
COOWNER_JID=194592469209292@lid

# ── AI Provider ───────────────────────────────────────────
# Options: groq (free, recommended) | openai
AI_PROVIDER=groq

# Get your free Groq key at: https://console.groq.com
GROQ_API_KEY=

# OR use OpenAI (gpt-4o-mini)
# OPENAI_API_KEY=

# ── Web search (optional) ─────────────────────────────────
# Used by the /search command. Get free key at: https://tavily.com
TAVILY_API_KEY=

# ── Multi-Bot Personality JID Mapping ─────────────────────
# For each WhatsApp number you link, assign it a personality.
# Format: BOT_<PERSONALITY_KEY>=<full_jid>
# Personalities: hinata, lunar, aria, kira, zephyr, nova, void, seraph, echo, raven, jinx
#
# Example (replace with your actual bot numbers):
# BOT_HINATA=447911123456@s.whatsapp.net
# BOT_LUNAR=447922234567@s.whatsapp.net
# BOT_VOID=447933345678@s.whatsapp.net
#
# Leave blank for any personality you're not using.
BOT_HINATA=
BOT_LUNAR=
BOT_ARIA=
BOT_KIRA=
BOT_ZEPHYR=
BOT_NOVA=
BOT_VOID=
BOT_SERAPH=
BOT_ECHO=
BOT_RAVEN=
BOT_JINX=

# ── Deployment ────────────────────────────────────────────
PORT=3000
DATA_DIR=/data
AUTH_DIR=/data/auth

# Optional: pin a specific group as the main RPG group for gate/artifact spawns
# MAIN_GROUP_ID=1234567890-1234567890@g.us
